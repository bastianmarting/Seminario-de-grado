  url = {https://www.frontiersin.org/journals/sociology/articles/10.3389/fsoc.2026.1771856/full},
  urldate = {2026-09-10},
  abstract = {IntroductionThe Chilean pension system, characterized by full privatization and individual capitalization, plays a central role in shaping old-age inequality. Despite widespread social unrest and demands for reform, a segment of the population continues to justify income-based pension differences, a phenomenon conceptualized as preferences for pension market justice. This study investigates the interplay between social class, meritocratic beliefs (distinguishing between effort and talent), and preferences for market justice in the Chilean pension system between 2016 and 2023.MethodsUsing six waves of panel data from the Chilean Longitudinal Social Survey-ELSOC (Nobservations = 5,755; Nindividuals = 1,027), the analysis employs Cumulative Link Mixed Models (CLMM) to examine longitudinal changes. This approach allows for the decomposition of variance into between-person and within-person effects, assessing how stable class positions and evolving meritocratic perceptions influence the legitimacy of market-based pension allocation.ResultsThe findings reveal a ``class neutralization'' phenomenon, where objective social class does not significantly predict support for pension market justice. Instead, support has grown across all groups. Meritocratic perceptions of effort are consistently associated with higher market justice preferences at both between- and within-person levels. Conversely, talent-based perceptions do not show a main effect but interact significantly with Specific Class Positions: they predict higher support among the intermediate class (between-person) and among unemployed individuals whose perceptions of talent rewards increase over time (within-person).DiscussionThese findings suggest that the institutional architecture of the pension system frames outcomes as results of individual responsibility, dampening class-based redistributive demands. Effort-based meritocracy acts as a key legitimizing ideology for pension inequality. However, talent-based justifications appear to function differently, serving as a compensatory narrative for the intermediate class and the unemployed to rationalize distributive outcomes in a context where the link between effort and reward is structurally constrained.},
  langid = {english},
  keywords = {chile,clases sociales,Estado: Por Leer,justicia de mercado,meritocracia,P4,P7,sistema de pensiones},
  file = {C:\Users\casamg2021\Zotero\storage\8L9XFL37\Castillo et al. - 2026 - Justification trajectories for pension inequality in Chile (2016–2023) the role of social class and.pdf}
}

@article{castillo_merit_perc_pref_2019,
  title = {{Meritocracia y desigualdad econ\'omica: Percepciones, preferencias e implicancias}},
  shorttitle = {{Meritocracia y desigualdad econ\'omica}},
  author = {Castillo, Juan C. and Torres, Alex and Atria, Jorge and Maldonado, Luis},
  year = 2019,
  month = mar,
  journal = {Rev. int. sociol.},
  volume = {77},
  number = {1},
  pages = {e117},
  issn = {1988-429X, 0034-9712},
  doi = {10.3989/ris.2019.77.1.17.114},
  url = {https://revintsociologia.revistas.csic.es/index.php/revintsociologia/article/view/1017},
  urldate = {2026-09-02},
  abstract = {The idea of meritocracy is related to the distribution of goods and rewards based on individual talent and effort, being a principle that legitimizes the unequal distribution of resources in modern societies. Despite the constant references to meritocracy in inequality and stratification research, there are still few conceptual and empirical attempts to understand to what extent individuals perceive and prefer meritocracy, as well as their consequences. The present research proposes a conceptual and empirical framework for studying meritocratic perceptions and preferences, which is then related with economic inequality variables. Using data from the Chilean survey ``Social justice and citizenship participation'' (N= 1,245), the analyses suggest that meritocratic perceptions and preferences are different constructs and that those perceiving an adequate functioning of meritocracy also perceive less economic inequality.},
  copyright = {https://creativecommons.org/licenses/by/4.0},
  langid = {spanish},
  keywords = {chile,desigualdad economicas,desigualdad ingresos,Estado: Por Leer,estatus subjetivo,meritocracia,nivel educacional,P2,P3b,P4,percepcion meritocracia,preferencias meritocracia},
  note = {"\textquestiondown Es posible distinguir percepciones y creencias respecto de la meritocracia?" (Castillo et al., 2019, p. 2)
\par
"es necesario y posible distinguir entre percepci\'on (lo que es) y preferencias (lo que deber\'ia ser) sobre la meritocracia, y que ambos elementos deben ser tomados en consideraci\'on en conjunto para poder avanzar en una agenda de investigaci\'on sobre este tema." (Castillo et al., 2019, p. 2)
\par
"percepciones y preferencias son constructos distintos de la meritocracia y corresponde analizarlos por separado." (Castillo et al., 2019, p. 8)
\par
En los resutlados se ve que
\par
"en relaci\'on con lo que sucede con respecto a la percepci\'on de la meritocracia, observamos que el ingreso posee un efecto positivo, mientras que el aumento en el nivel educacional se relaciona con una disminuci\'on en la percepci\'on de la meritocracia." (Castillo et al., 2019, p. 9)
\par
"ceteris paribus, el aumento neto de los ingresos conduce a percibir una mejor implementaci\'on del ideal meritocratico. No obstante, la percepci\'on de la meritocracia parece disminuir con el aumento del nivel educacional, lo que podr\'ia vincularse con los argumentos de Baer y Lambert (1982) que establecen que los mayores niveles educacionales conllevar\'ian una actitud m\'as cr\'itica respecto a la distribuci\'on de bienes en la sociedad." (Castillo et al., 2019, p. 9)
\par
"personas de un mayor estatus v\'ia nivel educacional aspirar\'ian a un mayor ingreso, situaci\'on que los podr\'ia hacer sentirse menoscabados relativamente respecto a su grupo de referencia" (Castillo et al., 2019, p. 9)
\par
\textbf{Invest futura.}
\par
"Como vemos, esta variable captura la mayor parte de los efectos de ingreso y educaci\'on, sugiriendo que procesos de comparaci\'on social con el grupo de referencia de estatus podr\'ian influir negativamente en la percepci\'on de la meritocracia. Si bien esta asociaci\'on no se encontraba prevista desde la fundamentaci\'on inicial, su inclusi\'on de manera exploratoria permite delinear posibles \'ambitos de investigaci\'on futura." (Castillo et al., 2019, p. 10)
\par
"hip\'otesis del inter\'es racional, ya que quienes consideran que est\'an en una posici\'on superior, tender\'an a percibir que en la sociedad la implementaci\'on del ideal meritocr\'atico funciona de mejor manera" (Castillo et al., 2019, p. 10)
\par
"Por lo tanto, m\'as all\'a de los indicadores objetivos como educaci\'on e ingreso, lo que las personas piensan respecto de ellas mismas en t\'erminos de jerarqu\'ia social resulta relevante para su visi\'on del funcionamiento de la meritocracia" (Castillo et al., 2019, p. 10)
\par
"Es decir, a mayor \textbf{preferencia} por la meritocracia se percibe m\'as desigualdad econ\'omica y a mayor percepci\'on de la meritocracia se percibe menos desigualdad econ\'omica" (Castillo et al., 2019, p. 11)
\par
"En este caso, la preferencia por la meritocracia estar\'ia expresando, adem\'as de una opci\'on normativa, una demanda por la redistribuci\'on vinculada a la mayor percepci\'on de desigualdad." (Castillo et al., 2019, p. 11)
\par
"mayor estatus a m\'as desigualdad percibida" (Castillo et al., 2019, p. 11)
\par
Discusiones
\par
"es posible identificar dos dimensiones distintas en la perspectiva subjetiva de la meritocracia, a saber, percepciones y preferencias." (Castillo et al., 2019, p. 12)
\par
"que se perciba un buen funcionamiento de la meritocracia no necesariamente se relaciona con que se considere que este sistema es el mejor y, por lo tanto, ser\'ia un error concluir un apoyo normativo a la meritocracia desde evaluaciones de su funcionamiento." (Castillo et al., 2019, p. 12)
\par
"Este aspecto afirma las concepciones sobre la funci\'on legitimadora de la meritocracia." (Castillo et al., 2019, p. 12)
\par
"alg\'un punto cr\'itico en el cual el funcionamiento de la meritocracia podr\'ia comenzar a afectar las preferencias," (Castillo et al., 2019, p. 12)
\par
"y muchas veces confundiendo percepciones con preferencias bajo el t\'ermino general de creencias" (Castillo et al., 2019, p. 12)
\par
"En segundo lugar, los elementos constitutivos m\'as tradicionales de la meritocracia, como son el esfuerzo y el talento, no han sido estudiados por separado a la fecha. El contar con medidas m\'as espec\'ificas para ambos, en combinaci\'on con las dimensiones perceptual y de preferencias, abre una serie de posibilidades para explorar nuevas caracter\'isticas de los aspectos subjetivos de la meritocracia." (Castillo et al., 2019, p. 13)
\par
"En segundo lugar, los elementos constitutivos m\'as tradicionales de la meritocracia, como son el esfuerzo y el talento, no han sido estudiados por separado a la fecha." (Castillo et al., 2019, p. 13)
\par
"En tercer lugar, la relaci\'on entre variables de estatus socioecon\'omico y meritocracia est\'a lejos de delinear un escenario claro y lineal. Tenemos evidencia de que dichas variables se relacionan principalmente con percepciones de la meritocracia pero, en general, de manera inversa, siendo lo m\'as interesante el indicio de una relaci\'on negativa entre mayor educaci\'on y menor percepci\'on de la meritocracia. Esto puede deberse a fen\'omenos de deprivaci\'on relativa, al efecto ilustrador de la educaci\'on, y/o a alg\'un otro motivo que merece mayor profundizaci\'on." (Castillo et al., 2019, p. 13)},
  file = {C:\Users\casamg2021\Zotero\storage\H2WEAU8G\Castillo et al. - 2019 - Meritocracia y desigualdad económica Percepciones, preferencias e implicancias.pdf}
}

@article{castillo_perception_2022,
  title = {Perception of Economic Inequality: Concepts, Associated Factors and Prospects of a Burgeoning Research Agenda ( {{{\emph{Percepci\'on}}}}{\emph{ de Desigualdad Econ\'omica: Conceptos, Factores Asociados y}} {\emph{Proyecciones de Una Agenda Creciente de Investigaci\'on}} )},
  shorttitle = {Perception of Economic Inequality},
  author = {Castillo, Juan-Carlos and {Garc{\'i}a-Castro}, Juan-Diego and Venegas, Mart{\'i}n},
  year = 2022,
  month = jan,
  journal = {International Journal of Social Psychology: Revista de Psicolog\'ia Social},
  volume = {37},
  number = {1},
  pages = {180--207},
  issn = {0213-4748, 1579-3680},
  doi = {10.1080/02134748.2021.2009275},
  url = {https://journals.sagepub.com/doi/10.1080/02134748.2021.2009275},
  urldate = {2026-10-14},
  abstract = {Perceptions of economic inequality have become a topic of growing interest in research from different social science disciplines. This article presents an up-to-date literature review of studies on this topic, stressing aspects related to its conceptualization and measurement, as well as psychosocial, socioeconomic and contextual factors associated with the perception of inequality. This review ends by pointing out some consequences of perception of inequality and identifying some pathways for future research agendas},
  langid = {english}
}

@article{castillo_perceptions_2025,
  title = {Perceptions of Inequality and Meritocracy: Their Interplay in Shaping Preferences for Market Justice in {{Chile}} (2016--2023)},
  shorttitle = {Perceptions of Inequality and Meritocracy},
  author = {Castillo, Juan Carlos and Laffert, Andreas and Carrasco, Kevin and {Iturra-Sanhueza}, Julio},
  year = 2025,
  month = sep,
  journal = {Front. Sociol.},
  volume = {10},
  publisher = {Frontiers},
  issn = {2297-7775},
  doi = {10.3389/fsoc.2025.1634219},
  url = {https://www.frontiersin.org/journals/sociology/articles/10.3389/fsoc.2025.1634219/full},
  urldate = {2026-09-02},
  abstract = {IntroductionSeveral countries have experienced a shift toward the privatization and commodification of public goods, welfare policies, and social services. In Latin America, Chile stands out as a paradigmatic case where this trend has led to the extensive marketization of essential services. From a moral economy perspective, the extent to which individuals consider it fair for access to such services to depend on market criteria has been conceptualized as market justice preferences. This study investigates the relationship between perceptions of economic inequality, meritocratic beliefs, and market justice preferences in Chile between 2016 and 2023.MethodsUsing six waves of panel data from the Chilean Longitudinal Social Survey-ELSOC (Nobservations = 8,643; Nindividuals = 1,687), the analysis examines how subjective assessments of inequality shape attitudes toward the role of merit in access to key social services such as healthcare, education, and pensions.ResultsThe findings show that greater perceived inequality is associated with lower market justice preferences. However, individuals who believe that effort is rewarded are more likely to legitimize existing disparities. In contrast, the perception that talent is rewarded shows a negative effect on market justice preferences; an effect that intensifies as perceived inequality increases over time. The study also considers the influence of major social movements during this period, which appear to have reshaped public discourse on justice and fairness.DiscussionThese findings contribute to a deeper understanding of how distributive beliefs evolve in contexts marked by persistent inequality and entrenched neoliberal frameworks. They indicate that while perceptions of inequality tend to undermine support for market justice, meritocratic beliefs-particularly those emphasizing effort-reinforce its legitimacy. By contrast, talent-based meritocratic perceptions weaken it, especially as inequality becomes more salient. The results also suggest that major collective events, such as the 2019 protests, did not fundamentally alter these underlying associations.},
  langid = {english},
  keywords = {chile,commodification,Estado: Por Leer,meritocracia,P1,P4,percepciones de desigualdad,preferencias publicas},
  note = {Este contexto de disparidad econ\'omica ha despertado un renovado inter\'es en estudiar no s\'olo los aspectos objetivos de la desigualdad, como el ingreso y el acceso a los recursos, sino tambi\'en sus dimensiones subjetivas, incluidas las \textbf{percepciones}, creencias y actitudes asociadas (\textbf{Janmaat, 2013}).~
\par
Estas dimensiones se consideran clave para comprender la deslegitimaci\'on de las instituciones pol\'iticas que puede provocar la desigualdad econ\'omica (\textbf{Castillo et al., 2022}). Por lo tanto, comprender c\'omo las personas perciben la desigualdad es crucial, ya que estas percepciones pueden influir en c\'omo las sociedades comprenden y justifican (o no) la desigualdad en la distribuci\'on de bienes y servicios, as\'i como en su capacidad para canalizar el descontento pol\'itico y, eventualmente, la oposici\'on a la distribuci\'on econ\'omica actual.
\par
\subsection{Justicia de mercado y Justicia Politica}

\begin{itemize}

\item ~justicia pol\'itica se refiere a acciones gubernamentales alineadas con principios de justicia como la igualdad o la necesidad, 
\item la justicia de mercado implica la asignaci\'on vinculada a los desiertos ganados, particularmente a trav\'es de contribuciones individuales basadas en el m\'erito individual

\end{itemize}

\par
en qu\'e medida los individuos consideran que es justo obtener un mejor acceso a los servicios sociales (como pensiones, salud y educaci\'on) en funci\'on de la capacidad de pago~
\par
-justicia de mercado como un sistema de ``desiertos ganados'', mediante el cual se considera que los individuos merecen un resultado distributivo determinado debido a su esfuerzo y habilidades. Carril 1986
\par
\textbf{dos} factores relevantes que suelen quedar marginados en esta literatura y que son clave para comprender las preferencias de justicia de mercado: 
\par
\begin{itemize}

\item la percepci\'on de desigualdad econ\'omica y 
\item la percepci\'on de meritocracia.

\end{itemize}

\par
percepci\'on de desigualdad
\par
\begin{itemize}

\item evaluaci\'on subjetiva que hace un individuo de c\'omo se asignan los recursos entre los miembros de una sociedad determinada

\end{itemize}

\par
percepci\'on a menudo subestima la brecha entre ricos y pobres, revelando inconsistencias entre los aspectos objetivos y subjetivos de la desigualdad (\textbf{Trump, 2018)}
\par
\begin{itemize}

\item ~las percepciones de desigualdad econ\'omica jugar\'ian un papel relevante para comprender las preferencias de justicia de mercado, ya que una menor desigualdad percibida podr\'ia reforzar la idea de que las diferencias en el acceso a los servicios sociales podr\'ian justificarse---un v\'inculo que se vuelve m\'as dif\'icil de mantener cuando se percibe una alta desigualdad.
\item \emph{Tambi\'en}: Los acad\'emicos han propuesto m\'ultiples dimensiones de la desigualdad percibida, incluida su magnitud (qu\'e tan significativas son las brechas), la estructura vertical (entre qu\'e grupos), la tendencia a lo largo del tiempo (aumentar o disminuir) y la legitimidad (ya sea justa o no) (\textbf{Engelhardt y Wagener, 2018}; \textbf{Garc\'ia-S\'anchez et al., 2019}).~
\item Una menor desigualdad percibida puede reforzar el apoyo a los acuerdos distributivos basados en el mercado (\textbf{Kuhn, 2011}). Por el contrario, cuando la desigualdad se percibe como excesiva, los individuos podr\'ian cuestionar la legitimidad de la justicia del mercado y apoyar m\'as las pol\'iticas redistributivas (\textbf{Garc\'ia-S\'anchez et al., 2019}).

\end{itemize}

\par
Percepci\'on de meritocracia
\par
\begin{itemize}

\item La meritocracia constituye un marco ideol\'ogico central para legitimar diversas formas de desigualdad social (\textbf{Mijs, 2016b}; \textbf{Wilson, 2003}).

\end{itemize}

\begin{itemize}

\item La meritocracia postula que la desigualdad puede legitimarse mediante criterios distributivos como el esfuerzo y el talento (\textbf{Davis y Moore, 2001}; \textbf{Joven, 1962})
\item Esta tendencia refleja no s\'olo el inter\'es material propio sino tambi\'en una econom\'ia moral m\'as amplia, en la que los ganadores del sistema de mercado internalizan las justificaciones del status quo. Al mismo tiempo, \textbf{la ideolog\'ia pol\'itica tambi\'en juega un papel} ---como los valores econ\'omicamente \textbf{conservadores}---, donde los individuos de derech\textbf{a muestran un mayor apoyo a la meritocracia} y m\'as \textbf{escepticismo hacia la redistribuci\'on.}
\item ~Las personas que creen que el \'exito es resultado del trabajo duro y el talento tienen m\'as probabilidades de considerar la desigualdad como leg\'itima (\textbf{Batruch et al., 2023}; \textbf{Castillo et al., 2012}; \textbf{Tejero-Peregrina et al., 2025}).
\item ~las personas pueden respaldar la meritocracia normativamente y al mismo tiempo reconocer su fracaso en la pr\'actica. En las sociedades estratificadas, la brecha entre preferencias y percepciones es particularmente evidente, ya que los individuos pueden seguir defendiendo el ideal de la meritocracia a pesar de la creciente conciencia de la desigualdad de oportunidades (\textbf{Mijs et al., 2022}).

\end{itemize}

\par
\begin{itemize}

\item 
\par
\textbf{SOBRE EL ESFUERZO Y TALENTO:}
\par
\begin{itemize}

\item 
\par
distinguimos adem\'as entre dos dimensiones centrales: percepciones basadas en el esfuerzo y percepciones basadas en el talento. Esta distinci\'on es anal\'iticamente importante, ya que captura diferentes mecanismos a trav\'es de los cuales los individuos pueden justificar la desigualdad (\textbf{Reynolds y Xian, 2014}; \textbf{Joven, 1962}).
\par
\begin{itemize}

\item Esfuerzo: Las percepciones basadas en el esfuerzo enfatizan el trabajo duro y la perseverancia como los impulsores clave del \'exito, aline\'andose estrechamente con las narrativas culturales de responsabilidad individual y merecimiento moral (\textbf{Dubet, 2011})
\item 
\par
Talento: las percepciones basadas en el talento enfatizan la capacidad innata y la inteligencia---rasgos que a menudo se consideran menos maleables y distribuidos de manera m\'as desigual (\textbf{Joven, 1962}). Sostenemos que esta \'ultima dimensi\'on puede moldear las actitudes de manera diferente, ya que el talento tiende a ser visto como un atributo determinado y no como el resultado de un esfuerzo personal.
\par
\end{itemize}

\item En conjunto, y como \textbf{Busemeyer y otros. (2021)}sostiene que las na\textbf{rrativas meritocr\'aticas} pueden operar como mecanismos de retroalimentaci\'on que dan forma a la opini\'on p\'ublica y al bienestar individual al enmarcar los resultados del bienestar como merecidos o inmerecidos.~

\end{itemize}

\end{itemize}

\par
nEOLIBERALISOMO
\par
\begin{itemize}

\item Este mecanismo es particularmente relevante en contextos neoliberales como Chile, donde las l\'ogicas de mercado moldean en gran medida las actitudes sociales (\textbf{Canales Cer\'on et al., 2021}).

\end{itemize}

\par
reSULTADOS 
\par
los que interesan respecto a meritocracia 
\par
\begin{itemize}

\item \textbf{Curiosamente, los cambios intraindividuales en las percepciones meritocr\'aticas a lo largo del tiempo (\emph{H}2\emph{\textsubscript{b}}) revelar efectos mixtos. Si bien los aumentos en la creencia de que las recompensas se basan en el esfuerzo individual est\'an asociados con preferencias m\'as fuertes por la justicia del mercado, los aumentos en la creencia de que las recompensas derivan del talento est\'an vinculados a un apoyo m\'as d\'ebil a tales principios. Una posible explicaci\'on es que el esfuerzo generalmente se considera un rasgo controlable y maleable, mientras que el talento tiende a ser percibido como innato y menos sujeto al control personal, lo que hace que la desigualdad basada en el talento sea menos leg\'itima. Adem\'as, una mayor exposici\'on a escenarios del mundo real en los que los resultados est\'an claramente determinados por rasgos inherentes en lugar de trabajo duro puede llevar a las personas a cuestionar la equidad y la legitimidad de los sistemas de recompensa basados en el mercado.}
\item mayores percepciones de desigualdad econ\'omica se asocian con un menor apoyo a las preferencias de justicia de mercado
\item , las percepciones meritocr\'aticas ---particularmente aquellas que enfatizan el esfuerzo individual--- est\'an fuertemente asociadas con el apoyo a distribuciones basadas en el mercado, lo que sugiere que la meritocracia sirve como justificaci\'on moral para las desigualdades estructurales. Sin embargo, los cambios en las percepciones meritocr\'aticas a lo largo del tiempo revelan un panorama m\'as matizado: mientras que un mayor \'enfasis en el esfuerzo refuerza el apoyo a la justicia del mercado, un mayor \'enfasis en el talento tiende a reducirlo.
\item ~Esta distinci\'on probablemente refleja creencias m\'as amplias sobre la controlabilidad y equidad de diferentes rasgos meritocr\'aticos IMPORTANTE, PODER CITAR LUEGO. ES UN GRAN HALLAZGO EMPIRICO SOBRE EL CONTROL QUE SE PERCIBE DEL TALENTO Y EL ESFUERZO. 

\end{itemize}},
  file = {C\:\\Users\\casamg2021\\Zotero\\storage\\7YV8IFTB\\Castillo et al_spa.pdf;C\:\\Users\\casamg2021\\Zotero\\storage\\UZK5BVFY\\Castillo et al. - 2025 - Perceptions of inequality and meritocracy their interplay in shaping preferences for market justice.pdf}
}

@misc{castillo_socialization_2022,
  title = {The {{Socialization}} of {{Meritocracy}}: {{The}} Role of the {{Family}} and the {{School}}},
  shorttitle = {The {{Socialization}} of {{Meritocracy}}},
  author = {Castillo, Juan C and {Iturra-Sanhueza}, Julio and Meneses, Francisco J and Venegas, Mart{\'i}n and Miranda, Daniel},
  year = 2022,
  month = sep,
  number = {f7bzq\_v1},
  publisher = {SocArXiv},
  doi = {10.31235/osf.io/f7bzq},
  url = {https://osf.io/preprints/socarxiv/f7bzq_v1/},
  urldate = {2026-09-10},
  abstract = {Meritocracy is understood as a system of distribution based on individual effort and talent. It has been widely questioned for its role in legitimizing social inequalities, given that it would lead to attributing personal success or failure to individual factors over social determinants. This research focuses on how some notions of meritocracy are learned during the school stage, considering the possible influence of socializing agents such as the family and the school. Using data from students and their families in 3 regions of Chile (N= 1,635 students from 64 schools), we analyze the extent to which parents' meritocratic perceptions are associated with their children, as well as the influence of the school experience of justice on grades. The results partially demonstrate that meritocratic perceptions are transmitted intergenerationally. Nevertheless, we find little evidence that this relationship is affected by the experience of distributive justice at school.},
  keywords = {educacion,Estado: Por Leer,familias,P3b,percepcion meritocracia,sentimiento de justicia,sistema escolar,socializacion},
  file = {C:\Users\casamg2021\Zotero\storage\V3ARZCIA\Castillo et al. - 2022 - The Socialization of Meritocracy The role of the Family and the School.pdf}
}

@article{castillo_todos_clase_media_2013,
  title = {Todos Somos de Clase Media: {{Sobre}} El Estatus Social Subjetivo En {{Chile}}},
  shorttitle = {Todos Somos de Clase Media},
  author = {Castillo, Juan Carlos and Miranda, Daniel and Cabib, Ignacio Madero},
  year = 2013,
  journal = {Latin American Research Review},
  volume = {48},
  number = {1},
  pages = {155--173},
  publisher = {Latin American Studies Association},
  issn = {1542-4278},
  url = {https://muse.jhu.edu/pub/101/article/504733},
  urldate = {2026-04-02},
  abstract = {Chile es uno de los pa\'ises con mayor concentraci\'on del ingreso a nivel mun-dial. Dada la relaci\'on entre alta desigualdad econ\'omica y patrones de estratificaci\'on social, en tal contexto se esperar\'ia una alta dispersi\'on de las percepciones respecto del propio estatus o estatus social subjetivo. Sin embargo, la evidencia internacional se\~nala una marcada tendencia hacia la media del estatus subjetivo, es decir, existir\'ian distorsiones del estatus subjetivo respecto del estatus objetivo. La presente investigaci\'on intenta profundizar en este aspecto para el caso de Chile, particularmente en la relaci\'on entre estatus socioecon\'omico, clase social y estatus subjetivo. Los datos a analizar corresponden al m\'odulo de desigualdad econ\'omica de la encuesta International Social Survey Programme (ISSP), en su versi\'on del a\~no 2009 para Chile. Los resultados indican una marcada tendencia en la poblaci\'on hacia la media del estatus subjetivo, principalmente de parte de aquellos con mayor estatus objetivo.},
  keywords = {chile,clases sociales,Estado: Por Leer,estatus objetivo,estatus subjetivo,P3b,verificar}
}

@misc{cfps_data,
  title = {China {{Family Panel Studies}} ({{CFPS}})},
  author = {{Institute of Social Science Survey, Peking University}},
  year = 2015,
