@article{guerriero_more_2026,
  title = {A {{More Equal World}}?},
  author = {Guerriero, Arthur Zito},
  year = 2026,
  month = mar,
  journal = {Sociology of Development},
  volume = {12},
  number = {1},
  pages = {32--64},
  issn = {2374-538X},
  doi = {10.1525/sod.2025.26813410},
  url = {https://online.ucpress.edu/socdev/article/12/1/32/212094/A-More-Equal-World-Trends-in-Global-Inequality},
  urldate = {2026-10-26},
  abstract = {Global income inequality declined between 2000 and 2020, but the forces driving this process may be winding down, leaving the world with very high inequality. China's rapid growth has been one of the main forces driving the downward trend, but it will have the opposite effect once incomes in the country exceed a certain level. I calculate this level for different measures of inequality, and identify which parts of the Chinese distribution have exceeded these thresholds. I find that China's growth is already contributing to inequality for some measures, such as Theil-L, and project that it will contribute to an increase in all inequality measures in the coming years. Projections for 2020 to 2040 show that this process will have a major impact on the trajectory of global inequality. If the growth rates of 2000 to 2020 continue, global inequality will start to rise as early as 2027. Global inequality will only continue to fall with faster income growth in Sub-Saharan Africa and South Asia, while continued rapid growth in East Asia will have a disequalizing effect.},
  langid = {english}
}

@article{guijarrorubinat_centralidad_2020,
  title = {La Centralidad de Los Criterios de Merecimiento En La Explicaci\'on de Las Actitudes Hacia La Condicionalidad de La Pol\'itica Social},
  author = {Guijarro Rubinat, Xavier},
  year = 2020,
  month = mar,
  journal = {Rev. int. sociol.},
  volume = {78},
  number = {1},
  pages = {e149},
  issn = {1988-429X, 0034-9712},
  doi = {10.3989/ris.2020.78.1.18.037},
  url = {https://revintsociologia.revistas.csic.es/index.php/revintsociologia/article/view/1050},
  urldate = {2026-10-12},
  abstract = {Las pol\'iticas de activaci\'on laboral y el paradigma de la inversi\'on social han promovido el debate acerca de la evoluci\'on de los estados de bienestar hacia una mayor condicionalidad de la pol\'itica social. Este estudio explora el papel de los criterios de merecimiento y sus interacciones con el autointer\'es y la ideolog\'ia para entender c\'omo las personas desarrollan actitudes espec\'ificas hacia la condicionalidad de la pol\'itica social. Las conclusiones se extraen a trav\'es del an\'alisis de la literatura y de una encuesta de opini\'on p\'ublica en Catalu\~na que presenta una oportunidad \'unica para desarrollar una estrategia emp\'irica fundamentada en la distinci\'on te\'orica entre criterios de merecimiento y condicionalidad de la pol\'itica social. El an\'alisis evidencia el poder explicativo de los criterios de merecimiento y c\'omo estos interfieren con el autointer\'es y la ideolog\'ia. Los hallazgos son espec\'ificamente relevantes para la comunicaci\'on pol\'itica.},
  copyright = {https://creativecommons.org/licenses/by/4.0},
  keywords = {Estado: Por Leer,P5,verificar},
  note = {"Retomando los objetivos principales de la investigaci\'on, el an\'alisis ha mostrado el gran poder explicativo de los criterios de merecimiento en el \'ambito de las actitudes hacia la condicionalidad (m\'as que el autointer\'es y la ideolog\'ia): cuanta m\'as importancia se da a la conducta y a la necesidad como criterios de merecimiento, mayor condicionalidad. La integraci\'on con las motivaciones prosociales y la idea de la econom\'ia moral de los EB anticipaba, en el marco te\'orico, las razones que hacen comprensible la centralidad de los criterios de merecimiento. Esto tiene que ver con su capacidad para fundamentar los efectos de la ideolog\'ia y del autointer\'es, pero, especialmente, por atender a claves explicativas habitualmente desatendidas. Los criterios de merecimiento tienen que ver con las reglas que regulan la cooperaci\'on: sit\'uan la idea de un homo reciprocans ampliando la mirada m\'as all\'a del homo economicus (autointer\'es) y el homo sociologicus (ideolog\'ia)." (Guijarro Rubinat, 2020, p. 11)
\par
"Si bien los criterios de merecimiento seg\'un conducta y necesidad han sido la dimensi\'on explicativa central con diferencia, se ha podido observar que el autointer\'es y la ideolog\'ia se relacionan con las actitudes hacia la condicionalidad seg\'un lo esperado (los individuos m\'as igualitaristas y de izquierdas, as\'i como los situados en posiciones estructurales m\'as desfavorables, son menos condicionales). Tambi\'en se ha corroborado que distintos grupos sociales usan distintos criterios, aunque los resultados obligan a matizar la afirmaci\'on en dos direcciones. Primero, el autointer\'es y la ideolog\'ia tienen una capacidad limitada para explicar los criterios que se usan. Segundo, gracias a la distinci\'on entre merecimiento y condicionalidad, se observa que se pueden apoyar determinados criterios de merecimiento seg\'un la posici\'on estructural sin que autom\'aticamente impliquen un grado espec\'ifico de condicionalidad de la pol\'itica social (aportando evidencia para refutar la hip\'otesis de la competitividad por los recursos)." (Guijarro Rubinat, 2020, p. 11)
\par
"En segundo lugar, en relaci\'on con la comunicaci\'on pol\'itica, el an\'alisis emp\'irico da cuenta del poder que pueden tener los mensajes relativos a motivar el desarrollo de actitudes anteponiendo las cuestiones basadas en el merecimiento. Cuanta mayor parte de la poblaci\'on perciba conductas que no generan merecimiento entre los beneficiarios de una pol\'itica social, m\'as condicionales y menos a favor de esa pol\'itica se mostraran. Por contra, si los mensajes se dirigen a poner en valor la situaci\'on de necesidad de la poblaci\'on beneficiaria de prestaciones (y no sus conductas), un mayor n\'umero de gente formar\'a sus actitudes bas\'andose en la solidaridad. Asimismo, es posible pensar en estrategias discursivas que no traten de anteponer el merecimiento, sino el autointer\'es o la ideolog\'ia" (Guijarro Rubinat, 2020, p. 11)
\par
"\textquestiondown es posible entender a trav\'es de ellos el apoyo amplio y estable a los EB y, a su vez, las diferencias entre pa\'ises?" (Guijarro Rubinat, 2020, p. 12)},
  file = {C:\Users\casamg2021\Zotero\storage\ZAG7IJT5\Guijarro Rubinat - 2020 - La centralidad de los criterios de merecimiento en la explicación de las actitudes hacia la condicio.pdf}
}

@book{harden_2021,
  title = {{La loter\'ia gen\'etica}},
  author = {Harden, Kathryn Paige},
  year = 2021,
  publisher = {Deusto},
  isbn = {978-84-234-3451-0},
  langid = {spanish},
  keywords = {desigualdades,Estado: Por Leer,eugenesia,genetica,loteria,P5,suerte,talento,verificar},
  note = {"La capacidad de etiquetar m\'ultiples variantes midiendo s\'olo una es el resultado de c\'omo se hacen las c\'elulas de los \'ovulos y el esperma." (Harden, p. 69)
\par
"Recordemos la diferencia entre los humanos y las bacterias: en lugar de copiarnos a nosotros mismos el ADN letra por letra, nos reproducimos sexualmente. Es decir, creamos las c\'elulas del esperma o los \'ovulos, cada una de las cuales contiene la mitad de nuestro ADN, mientras la otra mitad del genoma necesario para crear" (Harden, p. 69)
\par
"en el proceso de la meiosis tiene lugar algo llamado recombinaci\'on. En cada uno de mis veintitr\'es pares de cromosomas, el cromosoma que hered\'e de mi madre y el cromosoma que hered\'e de mi padre se alinean e intercambian trozos. Este proceso de recombinaci\'on, en realidad, recombina las variantes gen\'eticas en nuevas combinaciones que son todas diferentes entre s\'i." (Harden, p. 69)
\par
"El proceso de recombinaci\'on es la base biol\'ogica de lo que Gregor Mendel, a partir de sus observaciones matem\'aticas, llam\'o la ley de la transmisi\'on independiente. La probabilidad de heredar una determinada versi\'on del gen A es independiente de la probabilidad de heredar una determinada versi\'on del gen B. Excepto, por supuesto, cuando el gen A y el gen B est\'an f\'isicamente muy cerca en el genoma. La recombinaci\'on mezcla la <<baraja>> metaf\'orica de los cromosomas paternos y maternos, pero lo hace mal, dejando grupos de cartas pegados. Cuando los genes est\'an f\'isicamente m\'as pr\'oximos, la posibilidad de que se produzca una recombinaci\'on en el espacio que queda entre ellos es menor. Es probable que los genes que se encuentran f\'isicamente muy cerca se hereden juntos, en lugar de separados por la mezcla de la recombinaci\'on. Los genes que probablemente se hereden juntos, debido a su proximidad f\'isica, se dice que est\'an ligados. La ligaz\'on hace que los genes est\'en correlacionados entre s\'i, es decir, est\'en en desequilibrio del ligamiento, o LD, por sus siglas en ingl\'es." (Harden, p. 69)
\par
"Comprender la estructura LD del genoma humano ha resultado ser extraordinariamente \'util para muchos fines, entre ellos lograr que la medici\'on del genoma en los GWAS sea m\'as eficiente. Pero si un GWAS descubre que un SNP concreto est\'a asociado a, por ejemplo, llegar m\'as lejos en los estudios, no queda claro si la asociaci\'on est\'a motivada por ese SNP o si la se\~nal detectada se debe al hecho de que el SNP que se ha medido se hereda conjuntamente con una variante que no se ha medido." (Harden, p. 70)
\par
"Esta incoherencia de los hallazgos en distintos contextos no significa que las puntuaciones de Yelp sean una manera irremediablemente defectuosa de lo mucho que le gustan a la gente los restaurantes, o que los resultados de los GWAS sean in\'utiles. S\'i significa, sin embargo, que los resultados que se obtienen utilizando una medida tomada en un momento y lugar determinados no pueden generalizarse necesariamente en todas partes." (Harden, p. 71)
\par
"En tercer lugar, los resultados de los GWAS no muestran, de ninguna manera, que el ambiente no sea importante en la educaci\'on." (Harden, p. 71)
\par
"En sexto lugar, los resultados de los GWAS no te ense\~nar\'an a cocinar. Es decir, la lista de ingredientes gen\'omicos (SNP) no te cuenta los mecanismos que hacen que esos ingredientes se unan para producir un resultado complejo." (Harden, p. 72)},
  file = {C:\Users\casamg2021\Zotero\storage\YRDMNSIZ\Harden - 2021 - La lotería genética.pdf}
}

@article{howe_innate_1998,
  title = {Innate Talents: {{Reality}} or Myth?},
  shorttitle = {Innate Talents},
  author = {Howe, Michael J. A. and Davidson, Jane W. and Sloboda, John A.},
  year = 1998,
  month = jun,
  journal = {Behav Brain Sci},
  volume = {21},
  number = {3},
  pages = {399--407},
  issn = {0140-525X, 1469-1825},
  doi = {10.1017/S0140525X9800123X},
  url = {https://www.cambridge.org/core/product/identifier/S0140525X9800123X/type/journal_article},
  urldate = {2026-10-12},
  abstract = {Talents that selectively facilitate the acquisition of high  levels of skill are said to be present in some children but not  others. The evidence for this includes biological correlates of  specific abilities, certain rare abilities in autistic savants, and  the seemingly spontaneous emergence of exceptional abilities  in young children, but there is also contrary evidence indicating  an absence of early precursors of high skill levels. An analysis of  positive and negative evidence and arguments suggests that  differences in early experiences, preferences, opportunities,  habits, training, and practice are the real determinants of  excellence.},
  copyright = {https://www.cambridge.org/core/terms},
  langid = {english},
  keywords = {Estado: Urgente leer,the merit},
  note = {Los autores analizan el talento como una capacidad no elegida que influye en el desempe\~no de una persona. Sin embargo, se\~nalan que su desarrollo depende de factores sociales como la nutrici\'on, la atenci\'on m\'edica, la educaci\'on y la formaci\'on. Adem\'as, no todas las capacidades son reconocidas como talentos: aquello que cuenta como talentoso depende de las necesidades, valores y estructuras de cada sociedad y momento hist\'orico. 1 Por ello, el talento no es completamente ``natural'' ni puede separarse con facilidad del esfuerzo, ya que ambos se desarrollan y se combinan a lo largo del tiempo
\par
lo que parece una ventaja natural suele requerir instituciones, recursos y relaciones sociales para convertirse en una ventaja efectiva.
\par
El problema, seg\'un ellos, es que el talento y el esfuerzo no est\'an completamente separados. El talento puede desarrollarse mediante educaci\'on, pr\'actica, apoyo y condiciones sociales, mientras que el esfuerzo tambi\'en puede estar influido por capacidades y experiencias previas. Por eso, resulta dif\'icil afirmar que el resultado depende \'unicamente del esfuerzo individual. 1
\par
As\'i, el art\'iculo presenta dos ideas contrapuestas:
\par
F\'ormula igualitarista radical:
\par
m\'erito o logro = esfuerzo, sin talento natural ni clase social.
\par
Cr\'itica de los autores:
\par
esa f\'ormula es insuficiente porque el talento es un fen\'omeno complejo, din\'amico y relacionado con las condiciones sociales en las que se desarrolla. 1
\par
Por tanto, s\'i habla de una ``ecuaci\'on meritocr\'atica'', pero principalmente para mostrar sus l\'imites y discutir si es posible separar realmente el esfuerzo, el talento y las oportunidades sociales.},
  file = {C:\Users\casamg2021\Zotero\storage\Y7NR535G\innate.html}
}

