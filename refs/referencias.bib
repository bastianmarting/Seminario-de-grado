@article{castillo_et_al_multidimensional_merit_beliefs_2023,
  title = {A {{Multidimensional Approach}} for {{Measuring Meritocratic Beliefs}}: {{Advantages}}, {{Limitations}} and {{Alternatives}} to the {{ISSP Social Inequality Survey}}},
  shorttitle = {A {{Multidimensional Approach}} for {{Measuring Meritocratic Beliefs}}},
  author = {Castillo, Juan Carlos and Iturra, Julio and Maldonado, Luis and Atria, Jorge and Meneses, Francisco},
  year = 2023,
  month = nov,
  journal = {International Journal of Sociology},
  volume = {53},
  number = {6},
  pages = {448--472},
  issn = {0020-7659, 1557-9336},
  doi = {10.1080/00207659.2023.2274712},
  url = {https://www.tandfonline.com/doi/full/10.1080/00207659.2023.2274712},
  urldate = {2026-09-10},
  abstract = {A great part of the comparative international research that has attempted to measure meritocratic beliefs has used the social inequality module of the ISSP (International Social Survey Programme), which offers an unprecedented opportunity to compare meritocratic views in different societies. Based on a series of studies using ISSP data, the present paper proposes a multidimensional measurement framework for meritocratic beliefs. This framework distinguishes, on the one side, between perceptions and preferences and, on the other side, between meritocratic and not meritocratic aspects. In the first study, we test the multidimensional framework for meritocratic beliefs using the ISSP 2009 inequality module through confirmatory factor analysis (CFA) techniques. After identifying the advantages and some limitations of ISSP items for a multidimensional operationalization of meritocratic beliefs, in a second study, we suggest a modified set of items that better taps the different dimensions of meritocracy. We examined the measuring properties of this new instrument using a sample of Chilean adults (N 1\textfractionsolidus 4 2,141). Based on these results, we recommend improvements in measuring meritocratic beliefs in cross-national studies.},
  langid = {english},
  keywords = {Estado: Por Leer,P2,P4,verificar},
  note = {"y el funcionamiento de la meritocracia (Atria et al. 2020; Duru-Bellat y Tenret 2012; Mijs 2021; Reynolds y Xian 2014)." (Castillo et al., 2023, p. 448)
\par
"Debido al papel que las creencias meritocr\'aticas juegan en la justificaci\'on del logro individual (o fracaso) en las sociedades contempor\'aneas (Hadjar 2008; Markovits 2019; Sandel 2020), m\'ultiples estudios han evaluado la relaci\'on entre las creencias meritocr\'aticas y caracter\'isticas personales y (o) contextuales." (Castillo et al., 2023, p. 449)
\par
"Por ejemplo, algunos estudios han vinculado la meritocracia al fortalecimiento de estereotipos socioecon\'omicos, de g\'enero y \'etnicos (Girerd y Bonnot 2020, 2020; Madeira et al. 2019), as\'i como los efectos de las creencias meritocr\'aticas en la educaci\'on (Generett y Olson 2020; Owens y de St Croix 2020) y contextos organizacionales (Aiello et al. 2019; P\'yerez y Sabelis 2020)." (Castillo et al., 2023, p. 449)
\par
Citar. 
\par
Sobre el Talento e investigaciones futuras en su rleacion con la meritocracia. 
\par
"La cuesti\'on de si el talento (como inteligencia y capacidad) se considera o no meritocr\'atico es un tema pertinente para discutir desde un punto de vista filos\'ofico. Sin embargo, el peso del esfuerzo o del talento en lo que se considera meritocr\'atico deber\'ia dejarse a la supervisi\'on p\'ublica al examinar la investigaci\'on sobre las creencias meritocr\'aticas. Adem\'as, considerar el talento como parte de la meritocracia sin duda abre algunas v\'ias de investigaci\'on atractivas. Por ejemplo, algunos estudios sugieren que, para las \'elites, la meritocracia se relaciona con el talento, mientras que el esfuerzo es m\'as caracter\'istico de la meritocracia de las clases medias y bajas (Atria et al. 2020). Por lo tanto, sugerimos que un concepto (y una medida) de meritocracia se beneficia de incluir tanto el talento como el esfuerzo, como en la concepci\'on original de Young." (Castillo et al., 2023, p. 4)},
  file = {C\:\\Users\\casamg2021\\Zotero\\storage\\9LRNWNX5\\A-Multidimensional-Approach-for-Measuring-Meritocratic-Beliefs-Advantages-Limitations-and_translated_spa.pdf;C\:\\Users\\casamg2021\\Zotero\\storage\\QDND58FM\\Castillo et al. - 2023 - A Multidimensional Approach for Measuring Meritocratic Beliefs Advantages, Limitations and Alternat.pdf}
}

@article{castillo_justification_desigualdades_pensiones_clases_2026,
  title = {Justification Trajectories for Pension Inequality in {{Chile}} (2016--2023): The Role of Social Class and Beliefs in Meritocracy},
