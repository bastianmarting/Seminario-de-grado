@article{fercovic_2022,
  title = {Disentangling {{Meritocracy Among}} the {{Long-Range Upwardly Mobile}}: {{The Chilean Case}}},
  shorttitle = {Disentangling {{Meritocracy Among}} the {{Long-Range Upwardly Mobile}}},
  author = {Fercovic, Malik},
  year = 2022,
  month = mar,
  journal = {Sociological Research Online},
  volume = {27},
  number = {1},
  pages = {118--135},
  publisher = {SAGE Publications Ltd},
  issn = {1360-7804},
  doi = {10.1177/1360780420963395},
  url = {https://doi.org/10.1177/1360780420963395},
  urldate = {2026-09-10},
  abstract = {ResumenEn un mundo de crecientes desigualdades de ingresos y riqueza, estudiar la preocupaci\'on o el consentimiento popular sobre la desigualdad, la movilidad social y la meritocracia es cada vez m\'as relevante. Sin embargo, si bien existe un creciente conjunto de investigaciones sobre las explicaciones que los individuos dan a la desigualdad en Estados Unidos y Europa, hay una sorprendente ausencia de estudios que aborden c\'omo las personas que experimentan una movilidad ascendente de largo alcance se relacionan con los valores meritocr\'aticos en las sociedades latinoamericanas. En este art\'iculo me baso en 60 entrevistas a lo largo de mi vida para examinar c\'omo los individuos de largo alcance con movilidad ascendente --aquellos que mejor encarnan el ideal meritocr\'atico-- explican su \'exito en la sociedad chilena. Chile, conocido internacionalmente por la implementaci\'on de reformas neoliberales radicales desde mediados de la d\'ecada de 1970, tiene niveles elevados de desigualdad y altas tasas de movilidad ocupacional.Contrariamente al enfoque centrado en el individuo para el \'exito meritocr\'atico dominante en la literatura existente, mis hallazgos revelan un fuerte marco colectivo en las cuentas de los encuestados' y el reconocimiento de factores externos que dan forma a sus trayectorias ascendentes. Estos hallazgos tienen importantes implicaciones conceptuales, metodol\'ogicas y geogr\'aficas para el estudio futuro de la movilidad social y los valores meritocr\'aticos.},
  langid = {english},
  keywords = {Estado: Releer,meritocracia,movilidad social,P3b},
  note = {\section{Anotaciones\\
(14-10-2026, 1:43:15 a.~m.)}

\par
"M\'as que aumentar la movilidad, la meritocracia sigue estando predominantemente vinculada a la repro- ducci\'on de las posiciones de clase o estatus (Breen, 2004; Friedman y Laurison, 2019; Goldthorpe et al., 1980; Goldthorpe, 2003)" (Fercovic, 2022, p. 120)
\par
"este estudio ha sido muy relevante para verificar los compromisos normativos vinculados a la movilidad social y la meritocracia en las sociedades contempor\'aneas." (Fercovic, 2022, p. 120)
\par
"Sin embargo, las percepciones y creencias de las personas sobre la desigualdad social y los valores meritocr\'aticos merecen atenci\'on acad\'emica seria. Pueden ser una clave para se\~nalar la legitimidad de un determinado sistema de estratificaci\'on, las nociones de justicia social generalmente adheridas, as\'i como el potencial de descontento social asociado a la desigualdad (Kluegel y Smith, 1986)." (Fercovic, 2022, p. 120)
\par
"No obstante, la marcada rigidez en la parte alta de la estructura social no ha impedido la expansi\'on de los valores meritocr\'aticos entre los chilenos (Castillo et al., 2019). Estos \'ultimos parecen estar ganando protagonismo en la poblaci\'on en las \'ultimas d\'ecadas, aunque los valores merito- cr\'aticos chilenos no son los m\'as pronunciados de Am\'erica Latina (Bucca, 2016)" (Fercovic, 2022, p. 122)
\par
"hilenos tienden a atribuir la pobreza y la riqueza a causas individuales (trabajo, disciplina, talento) m\'as que a factores externos vinculados a las estructuras sociales; adem\'as, muestran preferencia por remuneraciones que recompensen el esfuerzo y la eficiencia, independientemente de si esto genera ine- quidades o riesgos en t\'erminos de seguridad laboral, que se consideran transitorios o bien merecidos." (Fercovic, 2022, p. 122)
\par
"En efecto, la manera en que las personas con movilidad ascendente se relacionan con los valores meritocr\'aticos es mediante la referencia a un conjunto multifac\'etico de factores: principalmente el esfuerzo, diferentes fuentes de apoyo y la suerte." (Fercovic, 2022, p. 131)
\par
"Mi investigaci\'on basada en m\'etodos cualitativos tambi\'en arroja luz sobre la relaci\'on entre la expansi\'on de una ideolog\'ia meritocr\'atica y la reestructuraci\'on neoliberal en Chile." (Fercovic, 2022, p. 131)
\par
"mis hallazgos muestran c\'omo las propias personas con movilidad ascendente no solo enfatizan la autosuficiencia, el \'exito socioecon\'omico y la competitividad ---las principales caracter\'isticas de lo que Lamont et al. (2016) denominan el <<yo neoliberal>>. Incluso entre los encuestados que adoptan un enfoque m\'as individualista, sus percepciones contienen rastros significativos de aprecio por el apoyo que han recibido y el papel de la suerte en sus logros." (Fercovic, 2022, p. 131)
\par
"Mis hallazgos tienen implicaciones conceptuales, metodol\'ogicas y geogr\'aficas para el estudio futuro de la movilidad social y de los valores meritocr\'aticos." (Fercovic, 2022, p. 132)},
  file = {C\:\\Users\\casamg2021\\Zotero\\storage\\GXW92JAJ\\Fercovic - 2022 - Disentangling Meritocracy Among the Long-Range Upwardly Mobile The Chilean Case.pdf;C\:\\Users\\casamg2021\\Zotero\\storage\\JICG7K6B\\Fercovic - 2022 - Disentangling Meritocracy Among the Long-Range Upwardly Mobile The Chilean Case_translated_spa.pdf}
}

@article{franetovic_concepciones_2017,
  title = {{Concepciones de m\'erito y meritocracia / Conceptions of merit and meritocracy}},
  author = {Franetovic, Gonzalo},
  year = 2017,
  publisher = {Pontificia Universidad Cat\'olica de Chile},
  doi = {10.13140/RG.2.2.14983.42401/1},
  url = {https://www.researchgate.net/doi/10.13140/RG.2.2.14983.42401/1},
  urldate = {2026-09-29},
  abstract = {De la presente revisi\'on bibliogr\'afica respecto a las concepciones de m\'erito y meritocracia emergen tres principales afirmaciones. En primer lugar, variados autores han dado cuenta de la serie de deficiencias que posee la idea de meritocracia en t\'erminos de claridad. Ante la noci\'on est\'atica y casi algebraica que propone Young (1964), se han propuesto una serie de redefiniciones que realzan el car\'acter eminentemente contextual y contingente que el m\'erito encarna para s\'i. As\'i, a pesar de que las capacidades y el esfuerzo se sit\'uan como componentes estables a lo largo de la literatura, aquello que se constituye como meritorio no puede ser objeto de replicaci\'on a un sinn\'umero de sociedades, sino por el contrario, refiere a din\'amicas sociales particulares de cada \'epoca y lugar. Un segundo punto importante es el olvido que tiene la idea de esfuerzo o motivaci\'on al interior de la discusi\'on conceptual del m\'erito. Variadas han sido las investigaciones que, apelando a determinar c\'omo es que la inteligencia se presenta a lo largo de los grupos sociales, intenta extraer conclusiones respecto a la forma en que el m\'erito se articula al interior de la estructura social. El esfuerzo, por el contrario, ha recibido constantemente -desde El Triunfo de la  Meritocracia hasta el presente- indiferencia por parte  de los estudiosos. Esta paradojal simultaneidad de una inclusi\'on permanente en la idea de m\'erito y un desinter\'es por ahondar en sus dimensiones y din\'amicas internas, resulta un hecho a lo menos particular. En \'ultimo t\'ermino, necesario es hacer alusi\'on a la polarizaci\'on que ha tenido el estudio de la meritocracia en las sociedades modernas. En tanto concepto eminentemente pol\'itico y vinculado a visiones de sociedad, el debate en materia emp\'irica respecto a la meritocracia ha visto una escasa presencia de grises o puntos intermedios. La evidencia m\'as clara de ello es la afamada oposici\'on que Goldthorpe y Saunders animaron al interior de la discusi\'on respecto a la movilidad social en Gran Breta\~na. Estas profundas discrepancias podr\'ian explicarse, en primer lugar, por la importancia que comenz\'o a albergar la idea de meritocracia en materia de justicia social, comenzando en una idea sat\'irica y posteriormente motivando el discurso de variados movimientos y partidos pol\'iticos alrededor del mundo, entre ellos el laborista brit\'anico. Y, asimismo, por las variadas falencias que presenta al respecto en materia conceptual, las cuales variados autores anteriormente han recalcado},
  langid = {spanish},
  keywords = {Estado: Leido,merito,meritocracia,P2,P4},
  file = {C:\Users\casamg2021\Zotero\storage\DC6FFJN4\Franetovic - 2017 - Concepciones de mérito y meritocracia  Conceptions of merit and meritocracy.pdf}
}

