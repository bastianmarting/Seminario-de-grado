@article{sachweh_moral_2012,
  title = {The Moral Economy of Inequality: Popular Views on Income Differentiation, Poverty and Wealth},
  shorttitle = {The Moral Economy of Inequality},
  author = {Sachweh, P.},
  year = 2012,
  month = jul,
  journal = {Socio-Economic Review},
  volume = {10},
  number = {3},
  pages = {419--445},
  issn = {1475-1461, 1475-147X},
  doi = {10.1093/ser/mwr023},
  url = {https://academic.oup.com/ser/article-lookup/doi/10.1093/ser/mwr023},
  urldate = {2026-08-26},
  abstract = {Este art\'iculo analiza c\'omo la gente com\'un en Alemania percibe y legitima las disparidades econ\'omicas en una era de creciente desigualdad de ingresos. A partir de entrevistas cualitativas en profundidad con participantes de clases sociales altas y bajas, el estudio reconstruye la <<econom\'ia moral>> que subyace a las concepciones populares de la desigualdad. Si bien los participantes coinciden con los principios abstractos de desigualdad ---es decir, la diferenciaci\'on de ingresos basada en el m\'erito---, les preocupan casos espec\'ificos de desigualdad, especialmente la pobreza y la riqueza. Estos casos son criticados porque se consideran que implican desviaciones intolerables, tanto ascendentes como descendentes, de un modo de vida que se presume universal, fomentando as\'i la segregaci\'on de los mundos vitales y la desintegraci\'on social. Por lo tanto, las percepciones de injusticia no parecen basarse en la existencia de la desigualdad de ingresos en s\'i misma, sino m\'as bien en la idea de que las disparidades econ\'omicas amenazan el v\'inculo social. Palabras clave:clase social, desigualdad, normas morales, teor\'ia de la justicia, pobreza, riqueza Clasificaci\'on JEL:A13 Relaci\'on de la econom\'ia con los valores sociales, D60 Econom\'ia del bienestar, D63 Equidad, justicia, desigualdad},
  langid = {english},
  keywords = {Estado: Por Leer,P5},
  note = {"umento no solo tiene importantes consecuencias distributivas," (Sachweh, 2012, p. 419)
\par
"se ha sugerido que en tiempos de creciente desigualdad podr\'ia surgir un "abismo de empat\'ia", una "distancia ps\'iquica entre los que no tienen y los que tienen" (Shapiro, 2002(p. 120), lo que hace imposible que un grupo imagine las circunstancias del otro" (Sachweh, 2012, p. 419)
\par
"a medida que las disparidades econ\'omicas se vuelven m\'as evidentes, las personas pueden tomar conciencia de sus propias suposiciones impl\'icitas sobre la desigualdad, o estas pueden eventualmente cambiar." (Sachweh, 2012, p. 419)
\par
Las concepciones son importantes para la integracion social. 
\par
""econom\'ia moral" m\'as amplia, es decir, una comprensi\'on impl\'icita y compartida colectivamente de lo que constituye una distribuci\'on justa y deseable de los beneficios y las cargas sociales" (Sachweh, 2012, p. 420)
\par
